# ---- xAI ----
# Server-side API key. Used for REST calls and to authenticate the realtime
# WebSocket for SIP call_id sessions. Ephemeral client secrets do NOT work for
# SIP call_id sessions, so this key never leaves the server.
XAI_API_KEY=xai-...
XAI_API_BASE=https://api.x.ai
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime
XAI_VOICE_MODEL=grok-voice-latest

# ---- Public host ----
# Must be publicly reachable: xAI POSTs call webhooks here AND connects to the
# MCP endpoint here directly (MCP tools are server-side; xAI dials out to them).
# In dev use an ngrok/cloudflared tunnel.
PUBLIC_BASE_URL=https://your-tunnel.example.com
PORT=3000

# ---- Webhook verification ----
# Returned ONCE by POST /v2/phone-numbers and unrecoverable afterwards.
# `npm run provision` writes it to the DB; this env var is the escape hatch for
# a secret you already hold.
XAI_WEBHOOK_SIGNING_SECRET=

# ---- MCP ----
# Secret used to sign per-call MCP session tokens. Any random 32+ byte string.
MCP_TOKEN_SECRET=change-me-to-a-long-random-string

# ---- SMS (identity linking only; not used for voice) ----
# xAI does not send SMS, so account-linking OTP needs a separate provider.
# `console` prints the code to stdout and is the default for local development.
SMS_PROVIDER=console
SMS_FROM=
SMS_API_KEY=
SMS_ACCOUNT_SID=

# ---- Platform economics ----
# Hard floor enforced at write time. Creators may price above it, never below.
PLATFORM_MIN_PRICE_PER_MINUTE_CENTS=50
# What xAI charges us, used for margin reporting only.
PLATFORM_AUDIO_COST_PER_MINUTE_CENTS=6

# ---- Call policy ----
MAX_SESSION_SECONDS=7200
LOW_BALANCE_WARNING_SECONDS=120
FINAL_WARNING_SECONDS=30
IDLE_TIMEOUT_MS=12000

# ---- Storage ----
DATABASE_PATH=./data/caller.db
